---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppFloat from "../../components/WhatsAppFloat.astro";
import { propiedades } from "../../data/propiedades";
import { site, whatsappLink } from "../../data/site";

export function getStaticPaths() {
  return propiedades.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const precioTxt = p.mostrarPrecio && p.precio ? p.precio : "Precio a consultar";

const specs = [
  p.recamaras && { l: "Recámaras", v: p.recamaras, i: "🛏️" },
  p.banos && { l: "Baños", v: p.banos, i: "🛁" },
  p.mediosBanos && { l: "Medios baños", v: p.mediosBanos, i: "🚽" },
  p.estacionamientos && { l: "Estacionamientos", v: p.estacionamientos, i: "🚗" },
  p.m2Construccion && { l: "Construcción", v: `${p.m2Construccion} m²`, i: "📐" },
  p.m2Terreno && { l: "Terreno", v: `${p.m2Terreno} m²`, i: "🌳" },
  p.niveles && { l: "Niveles", v: p.niveles, i: "🏢" },
  p.anio && { l: "Año", v: p.anio, i: "📅" },
].filter(Boolean);

const waMsg = `Hola Lourdes, me interesa la propiedad "${p.titulo}" en ${p.colonia}, ${p.alcaldia}. ¿Me das más información?`;
---

<Layout
  title={`${p.titulo} en ${p.operacion} — ${p.colonia}, ${p.alcaldia} | ${site.franquicia}`}
  description={`${p.tipo} en ${p.operacion} en ${p.colonia}, ${p.alcaldia}, ${p.estado}. ${precioTxt}. Con Lourdes Martínez, Century 21 Grupo Mormos.`}
>
  <Header />
  <main class="mx-auto max-w-6xl px-5 py-8">
    <!-- Breadcrumb -->
    <nav class="mb-6 text-sm text-ink/50">
      <a href="/" class="hover:text-gold-dark">Inicio</a> ·
      <a href="/propiedades/" class="hover:text-gold-dark">Propiedades</a> ·
      <span class="text-ink/70">{p.colonia}, {p.alcaldia}</span>
    </nav>

    <div class="grid gap-8 lg:grid-cols-[1.6fr_1fr]">
      <!-- Galería -->
      <div>
        <div class="overflow-hidden rounded-2xl border border-black/5 bg-cream">
          <img
            id="foto-principal"
            src={p.imagenes[0]}
            alt={`${p.titulo} — foto`}
            class="aspect-[4/3] h-full w-full cursor-zoom-in object-cover"
          />
        </div>
        {p.imagenes.length > 1 && (
          <div class="mt-3 grid grid-cols-5 gap-2 sm:grid-cols-6">
            {p.imagenes.map((img, i) => (
              <button
                type="button"
                class="thumb overflow-hidden rounded-lg border-2 border-transparent transition hover:border-gold"
                data-src={img}
                aria-label={`Ver foto ${i + 1}`}
              >
                <img src={img} alt={`${p.titulo} miniatura ${i + 1}`} loading="lazy" class="aspect-square h-full w-full object-cover" />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- Info -->
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <span class="inline-block rounded-full bg-ink px-3 py-1 text-xs font-semibold uppercase tracking-wide text-gold">
          {p.operacion}
        </span>
        <h1 class="mt-3 font-display text-2xl font-bold leading-tight">{p.titulo}</h1>
        <p class="mt-1 text-ink/60">{p.colonia}, {p.alcaldia}, {p.estado}</p>
        <p class="mt-4 font-display text-2xl font-bold text-gold-dark">{precioTxt}</p>

        <div class="mt-6 grid grid-cols-2 gap-3">
          {specs.map((s) => (
            <div class="rounded-lg border border-black/5 bg-cream px-3 py-2 text-sm">
              <span class="mr-1">{s.i}</span>
              <span class="font-semibold">{s.v}</span>
              <span class="text-ink/50"> · {s.l}</span>
            </div>
          ))}
        </div>

        <a
          href={whatsappLink(waMsg)}
          target="_blank"
          rel="noopener"
          class="mt-6 block rounded-full bg-gold px-6 py-3 text-center font-semibold text-ink transition hover:bg-gold-dark"
        >
          Solicitar información por WhatsApp
        </a>
        <a
          href={`tel:+52${site.telefonos[0].replace(/\s/g, "")}`}
          class="mt-3 block rounded-full border border-ink px-6 py-3 text-center font-semibold transition hover:bg-ink hover:text-white"
        >
          Llamar: {site.telefonos[0]}
        </a>

        <p class="mt-4 rounded-lg bg-cream p-3 text-xs text-ink/60">
          💡 Con Lourdes no pagas comisión ni gastos hasta que se cierre la operación.
        </p>
      </aside>
    </div>

    <!-- Descripción y amenidades -->
    <div class="mt-12 grid gap-10 lg:grid-cols-[1.6fr_1fr]">
      {p.descripcion && (
        <div>
          <h2 class="font-display text-xl font-bold">Descripción</h2>
          <div class="mt-3 whitespace-pre-line leading-relaxed text-ink/80">{p.descripcion}</div>
        </div>
      )}
      {p.amenidades && p.amenidades.length > 0 && (
        <div>
          <h2 class="font-display text-xl font-bold">Características</h2>
          <ul class="mt-3 grid grid-cols-2 gap-2 text-sm text-ink/80">
            {p.amenidades.map((a) => (
              <li class="flex items-center gap-2">
                <span class="text-gold">✓</span> {a}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div class="mt-12 border-t border-black/5 pt-8">
      <a href="/propiedades/" class="font-semibold text-gold-dark hover:underline">← Ver todas las propiedades</a>
    </div>
  </main>
  <Footer />
  <WhatsAppFloat />

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/90 p-4">
    <button id="lb-close" class="absolute right-5 top-5 text-3xl text-white" aria-label="Cerrar">×</button>
    <img id="lb-img" src="" alt="Foto ampliada" class="max-h-[90vh] max-w-[95vw] rounded-lg object-contain" />
  </div>

  <script is:inline>
    (function () {
      const main = document.getElementById("foto-principal");
      document.querySelectorAll(".thumb").forEach((btn) => {
        btn.addEventListener("click", () => {
          const src = btn.getAttribute("data-src");
          if (src) main.src = src;
          document.querySelectorAll(".thumb").forEach((b) => b.classList.remove("border-gold"));
          btn.classList.add("border-gold");
        });
      });
      const lb = document.getElementById("lightbox");
      const lbImg = document.getElementById("lb-img");
      main.addEventListener("click", () => {
        lbImg.src = main.src;
        lb.classList.remove("hidden");
        lb.classList.add("flex");
      });
      function close() { lb.classList.add("hidden"); lb.classList.remove("flex"); }
      document.getElementById("lb-close").addEventListener("click", close);
      lb.addEventListener("click", (e) => { if (e.target === lb) close(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
    })();
  </script>
</Layout>
