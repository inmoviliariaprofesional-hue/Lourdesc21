---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppFloat from "../../components/WhatsAppFloat.astro";
import PropiedadCard from "../../components/PropiedadCard.astro";
import { propiedades } from "../../data/propiedades";
import { site } from "../../data/site";

const estados = [...new Set(propiedades.map((p) => p.estado))].sort();
const tipos = [...new Set(propiedades.map((p) => p.tipo))].sort();
---

<Layout
  title={`Propiedades en venta y renta | ${site.nombre}`}
  description={`Explora ${propiedades.length} propiedades en CDMX, Estado de México y otros mercados con Lourdes Martínez.`}
  image={propiedades[0]?.imagenes[0]}
>
  <Header />
  <main id="contenido" class="bg-ivory">
    <section class="noise-overlay relative overflow-hidden bg-ink text-white">
      <div class="premium-grid absolute inset-0 opacity-60"></div>
      <div class="absolute -right-32 top-0 h-96 w-96 rounded-full bg-gold/10 blur-[120px]"></div>
      <div class="relative mx-auto max-w-7xl px-5 py-16 sm:px-7 md:py-24 lg:px-10">
        <nav class="text-xs text-white/42" aria-label="Migas de pan">
          <a href="/" class="hover:text-gold-light">Inicio</a><span class="mx-2">/</span><span aria-current="page">Propiedades</span>
        </nav>
        <div class="mt-9 grid gap-7 lg:grid-cols-[1fr_0.55fr] lg:items-end">
          <div>
            <p class="eyebrow !text-gold">Portafolio seleccionado</p>
            <h1 class="section-title mt-5 max-w-3xl">Encuentra el espacio para tu siguiente capítulo.</h1>
          </div>
          <p class="max-w-xl text-base leading-7 text-white/55 lg:justify-self-end">{propiedades.length} oportunidades en venta y renta. Compara por operación, ubicación y tipo de inmueble.</p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-10 sm:px-7 md:py-14 lg:px-10">
      <div class="premium-card z-20 mb-9 rounded-[1.4rem] p-4 sm:p-5 md:sticky md:top-[88px]">
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_1fr_auto] lg:items-end">
          <div>
            <label for="f-operacion" class="mb-1.5 block text-[0.63rem] font-semibold uppercase tracking-[0.14em] text-ink/50">Operación</label>
            <select id="f-operacion" class="w-full rounded-xl border border-ink/10 bg-white px-3 py-2.5 text-sm outline-none transition focus:border-gold">
              <option value="">Todas</option><option value="venta">Venta</option><option value="renta">Renta</option>
            </select>
          </div>
          <div>
            <label for="f-estado" class="mb-1.5 block text-[0.63rem] font-semibold uppercase tracking-[0.14em] text-ink/50">Estado</label>
            <select id="f-estado" class="w-full rounded-xl border border-ink/10 bg-white px-3 py-2.5 text-sm outline-none transition focus:border-gold">
              <option value="">Todos</option>{estados.map((e) => <option value={e}>{e}</option>)}
            </select>
          </div>
          <div>
            <label for="f-tipo" class="mb-1.5 block text-[0.63rem] font-semibold uppercase tracking-[0.14em] text-ink/50">Tipo</label>
            <select id="f-tipo" class="w-full rounded-xl border border-ink/10 bg-white px-3 py-2.5 text-sm outline-none transition focus:border-gold">
              <option value="">Todos</option>{tipos.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
          <button id="limpiar-filtros" type="button" class="btn-ghost-dark !min-h-10 !px-5 !py-2 text-xs">Limpiar</button>
        </div>
      </div>

      <div class="mb-7 flex items-center justify-between border-b border-ink/10 pb-4">
        <p id="contador" aria-live="polite" class="text-sm font-medium text-ink/60">{propiedades.length} propiedades</p>
        <p class="hidden text-xs text-ink/38 sm:block">Actualizado desde Century 21</p>
      </div>

      <div id="grid" class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {propiedades.map((p) => (
          <div class="prop-item" data-operacion={p.operacion} data-estado={p.estado} data-tipo={p.tipo}>
            <PropiedadCard p={p} />
          </div>
        ))}
      </div>

      <div id="vacio" class="hidden rounded-[2rem] border border-ink/10 bg-cream px-6 py-20 text-center">
        <p class="font-display text-2xl font-semibold">No encontramos coincidencias.</p>
        <p class="mt-2 text-sm text-ink/52">Prueba otra combinación o conversa con Lourdes para una búsqueda personalizada.</p>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppFloat />

  <script is:inline>
    (function () {
      const fOp = document.getElementById("f-operacion");
      const fEs = document.getElementById("f-estado");
      const fTi = document.getElementById("f-tipo");
      const clear = document.getElementById("limpiar-filtros");
      const items = Array.from(document.querySelectorAll(".prop-item"));
      const counter = document.getElementById("contador");
      const empty = document.getElementById("vacio");
      if (!fOp || !fEs || !fTi || !counter || !empty) return;

      const params = new URLSearchParams(location.search);
      fOp.value = params.get("operacion") || "";
      fEs.value = params.get("estado") || "";
      fTi.value = params.get("tipo") || "";

      function apply(updateUrl = true) {
        const op = fOp.value, es = fEs.value, ti = fTi.value;
        let visible = 0;
        items.forEach((el) => {
          const show = (!op || el.dataset.operacion === op) && (!es || el.dataset.estado === es) && (!ti || el.dataset.tipo === ti);
          el.classList.toggle("hidden", !show);
          if (show) visible++;
        });
        counter.textContent = `${visible} ${visible === 1 ? "propiedad" : "propiedades"}`;
        empty.classList.toggle("hidden", visible !== 0);
        if (updateUrl) {
          const next = new URLSearchParams();
          if (op) next.set("operacion", op);
          if (es) next.set("estado", es);
          if (ti) next.set("tipo", ti);
          history.replaceState(null, "", `${location.pathname}${next.size ? `?${next}` : ""}`);
        }
      }
      [fOp, fEs, fTi].forEach((select) => select.addEventListener("change", () => apply()));
      clear?.addEventListener("click", () => { fOp.value = ""; fEs.value = ""; fTi.value = ""; apply(); });
      apply(false);
    })();
  </script>
</Layout>
