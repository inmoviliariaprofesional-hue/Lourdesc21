---
import { site, whatsappLink } from "../data/site";
---

<section id="vendedores" class="relative overflow-hidden bg-cream">
  <div class="absolute right-0 top-0 h-[28rem] w-[28rem] rounded-full bg-gold/10 blur-[110px]"></div>
  <div class="section relative grid items-center gap-12 lg:grid-cols-[0.88fr_1.12fr]">
    <div class="reveal">
      <p class="eyebrow">Para propietarios</p>
      <h2 class="section-title mt-5">El precio correcto cambia toda la operación.</h2>
      <p class="mt-6 max-w-xl text-lg leading-8 text-ink/60">Una propiedad mal valuada pierde tiempo, margen y oportunidades. Comienza con una lectura profesional de su mercado real.</p>
      <ul class="mt-8 space-y-3 text-sm text-ink/68">
        <li class="flex gap-3"><span class="text-gold-dark">✓</span> Comparables actuales de la zona</li>
        <li class="flex gap-3"><span class="text-gold-dark">✓</span> Posicionamiento y estrategia de salida</li>
        <li class="flex gap-3"><span class="text-gold-dark">✓</span> Sin compromiso y con absoluta confidencialidad</li>
      </ul>
      <a href={whatsappLink("Hola Lourdes, quiero vender o rentar mi propiedad y conocer tu estrategia.")} target="_blank" rel="noopener" class="btn-ghost-dark mt-9">Conocer la estrategia</a>
    </div>

    <div id="analisis" class="reveal premium-card rounded-[2rem] p-6 sm:p-9 lg:p-11">
      <div class="flex items-start justify-between gap-5">
        <div>
          <p class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-gold-dark">Diagnóstico inicial</p>
          <h3 class="mt-3 text-3xl font-semibold">Análisis de mercado gratuito</h3>
        </div>
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-ink text-gold-light">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 19V9m6 10V5m6 14v-7m4 7H2"/></svg>
        </span>
      </div>
      <p class="mt-4 text-sm leading-7 text-ink/58">Déjanos los datos esenciales. Lourdes continuará la conversación personalmente por WhatsApp.</p>

      <form id="form-analisis" class="mt-7 space-y-4">
        <div>
          <label for="analisis-nombre" class="mb-1.5 block text-xs font-semibold text-ink/60">Nombre</label>
          <input id="analisis-nombre" required name="nombre" autocomplete="name" placeholder="¿Cómo te llamas?" class="w-full rounded-xl border border-ink/10 bg-white px-4 py-3 text-sm outline-none transition focus:border-gold" />
        </div>
        <div>
          <label for="analisis-telefono" class="mb-1.5 block text-xs font-semibold text-ink/60">Teléfono / WhatsApp</label>
          <input id="analisis-telefono" required name="telefono" type="tel" autocomplete="tel" placeholder="55 0000 0000" class="w-full rounded-xl border border-ink/10 bg-white px-4 py-3 text-sm outline-none transition focus:border-gold" />
        </div>
        <div>
          <label for="analisis-propiedad" class="mb-1.5 block text-xs font-semibold text-ink/60">Propiedad</label>
          <input id="analisis-propiedad" name="propiedad" placeholder="Ej. Departamento en Jardín Balbuena" class="w-full rounded-xl border border-ink/10 bg-white px-4 py-3 text-sm outline-none transition focus:border-gold" />
        </div>
        <button type="submit" class="btn-primary mt-2 w-full">Solicitar análisis gratuito</button>
      </form>
      <p class="mt-4 text-center text-[0.68rem] text-ink/42">Tus datos se utilizarán únicamente para responder esta solicitud.</p>
    </div>
  </div>
</section>

<script is:inline define:vars={{ waNumber: site.whatsapp }}>
  const form = document.getElementById("form-analisis");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const msg = `Hola Lourdes, quiero mi Análisis de Mercado Gratuito.\nNombre: ${data.get("nombre")}\nTeléfono: ${data.get("telefono")}\nPropiedad: ${data.get("propiedad") || "(no especificada)"}`;
    window.open(`https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`, "_blank", "noopener,noreferrer");
  });
</script>
