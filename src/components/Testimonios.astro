---
// Testimonios reales de clientes de Lourdes.
// La sección SOLO se muestra si este arreglo tiene elementos.
// Para activarla, agrega objetos: { texto, autor, zona }
const testimonios: { texto: string; autor: string; zona: string }[] = [
  // Ejemplo (descomentar y reemplazar con reseñas reales):
  // { texto: "Lourdes me acompañó en todo el proceso de compra...", autor: "Nombre del cliente", zona: "Jardín Balbuena" },
];
---

{testimonios.length > 0 && (
  <section id="testimonios" class="section">
    <h2 class="reveal text-center font-display text-3xl font-bold">Lo que dicen mis clientes</h2>
    <div class="reveal mt-12 grid gap-6 md:grid-cols-2">
      {testimonios.map((t) => (
        <figure class="rounded-2xl border border-black/5 bg-cream p-8">
          <div class="text-gold">★★★★★</div>
          <blockquote class="mt-3 text-ink/80">“{t.texto}”</blockquote>
          <figcaption class="mt-4 text-sm font-semibold">
            {t.autor} <span class="font-normal text-ink/50">· {t.zona}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
)}
