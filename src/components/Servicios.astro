---
const servicios = [
  {
    titulo: "Compra",
    texto: "Encuentra la propiedad correcta con acompañamiento en crédito y trámites.",
    icono: "🔑",
  },
  {
    titulo: "Venta",
    texto: "Vende al mejor precio con estrategia de mercado y difusión profesional.",
    icono: "🏷️",
  },
  {
    titulo: "Renta",
    texto: "Renta con seguridad, contratos claros y prospectos calificados.",
    icono: "📄",
  },
  {
    titulo: "Inversión",
    texto: "Invierte en zonas con plusvalía comprobada y rendimiento estimado.",
    icono: "📈",
  },
];
---

<section id="servicios" class="bg-cream">
  <div class="section">
    <h2 class="text-center font-display text-3xl font-bold">¿Cómo te puedo ayudar?</h2>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {servicios.map((s) => (
        <div class="rounded-xl border border-black/5 bg-white p-6 shadow-sm transition hover:shadow-md">
          <div class="text-3xl">{s.icono}</div>
          <h3 class="mt-4 font-display text-xl font-semibold">{s.titulo}</h3>
          <p class="mt-2 text-sm text-ink/70">{s.texto}</p>
        </div>
      ))}
    </div>
  </div>
</section>
