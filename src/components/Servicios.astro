---
const servicios = [
  { numero: "01", titulo: "Quiero comprar", texto: "Un portafolio curado y una ruta clara de crédito, visitas y negociación.", href: "#compradores", accion: "Encontrar propiedad" },
  { numero: "02", titulo: "Quiero vender", texto: "Valoración, presentación y estrategia comercial para proteger el valor de tu patrimonio.", href: "#vendedores", accion: "Valorar mi propiedad" },
  { numero: "03", titulo: "Quiero rentar", texto: "Opciones alineadas a tu presupuesto, zona y estilo de vida, sin perder tiempo.", href: "/propiedades/", accion: "Explorar opciones" },
  { numero: "04", titulo: "Quiero invertir", texto: "Oportunidades analizadas con enfoque en ubicación, demanda y potencial patrimonial.", href: "/propiedades/", accion: "Ver oportunidades" },
];
---

<section id="servicios" class="relative bg-cream">
  <div class="section">
    <div class="reveal max-w-3xl">
      <p class="eyebrow">Tu siguiente movimiento</p>
      <h2 class="section-title mt-5">¿Qué quieres lograr?</h2>
      <p class="mt-5 max-w-2xl text-lg text-ink/60">Cada operación necesita una estrategia distinta. Elige tu objetivo y comienza con información clara.</p>
    </div>

    <div class="reveal mt-12 grid gap-4 md:grid-cols-2">
      {servicios.map((s) => (
        <a href={s.href} class="lift-hover group relative min-h-64 overflow-hidden rounded-[1.75rem] border border-ink/10 bg-ivory p-7 md:p-9">
          <div class="absolute -right-16 -top-16 h-52 w-52 rounded-full border border-gold/25 transition duration-500 group-hover:scale-125 group-hover:bg-gold/5"></div>
          <span class="font-display text-xs font-semibold tracking-[0.2em] text-gold-dark">{s.numero}</span>
          <h3 class="mt-9 max-w-sm text-3xl font-semibold">{s.titulo}</h3>
          <p class="mt-4 max-w-md text-sm leading-7 text-ink/58">{s.texto}</p>
          <span class="mt-8 inline-flex items-center gap-3 text-sm font-semibold">
            {s.accion}<span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
