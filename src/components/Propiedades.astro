---
import { propiedadesDestacadas, propiedades } from "../data/propiedades";
import PropiedadCard from "./PropiedadCard.astro";

const destacadas = propiedadesDestacadas.length ? propiedadesDestacadas : propiedades.slice(0, 6);
---

<section id="propiedades" class="section">
  <div class="reveal flex flex-col items-center text-center">
    <h2 class="font-display text-3xl font-bold">Propiedades destacadas</h2>
    <p class="mt-3 max-w-xl text-ink/70">
      Una selección de mi portafolio en CDMX, Estado de México y más. Explora el catálogo completo o escríbeme para opciones a tu medida.
    </p>
  </div>

  <div class="reveal mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
    {destacadas.map((p) => <PropiedadCard p={p} />)}
  </div>

  <div class="mt-12 text-center">
    <a
      href="/propiedades/"
      class="inline-block rounded-full bg-gold px-8 py-3 font-semibold text-ink transition hover:bg-gold-dark"
    >
      Ver todas las propiedades ({propiedades.length})
    </a>
  </div>
</section>
