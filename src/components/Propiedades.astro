---
import { propiedadesDestacadas, propiedades } from "../data/propiedades";
import PropiedadCard from "./PropiedadCard.astro";
const destacadas = propiedadesDestacadas.length ? propiedadesDestacadas : propiedades.slice(0, 6);
---

<section id="propiedades" class="relative overflow-hidden bg-ink text-white">
  <div class="premium-grid absolute inset-0 opacity-60"></div>
  <div class="section relative">
    <div class="reveal flex flex-col justify-between gap-7 lg:flex-row lg:items-end">
      <div class="max-w-3xl">
        <p class="eyebrow !text-gold">Selección actual</p>
        <h2 class="section-title mt-5">Propiedades con potencial real.</h2>
        <p class="mt-5 max-w-2xl text-base leading-7 text-white/55">Explora oportunidades seleccionadas en CDMX, Estado de México y otros mercados activos.</p>
      </div>
      <a href="/propiedades/" class="btn-secondary shrink-0">Ver catálogo completo <span aria-hidden="true">→</span></a>
    </div>

    <div class="reveal mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {destacadas.map((p) => <PropiedadCard p={p} />)}
    </div>

    <div class="reveal mt-10 flex items-center justify-between border-t border-white/10 pt-7">
      <p class="text-xs uppercase tracking-[0.16em] text-white/40">Portafolio actualizado</p>
      <a href="/propiedades/" class="text-sm font-semibold text-gold-light hover:text-white">Explorar las {propiedades.length} propiedades →</a>
    </div>
  </div>
</section>
