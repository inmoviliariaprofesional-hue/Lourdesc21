---
import { whatsappLink } from "../data/site";
const pasos = [
  ["01", "Perfil y capacidad", "Definimos zona, estilo de vida, presupuesto y alternativas de crédito."],
  ["02", "Selección inteligente", "Filtramos el mercado para visitar únicamente opciones con sentido."],
  ["03", "Negociación y cierre", "Te acompaño en oferta, documentación, firma y entrega del inmueble."],
];
---

<section id="compradores" class="bg-ivory">
  <div class="section grid items-center gap-14 lg:grid-cols-[0.86fr_1.14fr]">
    <div class="reveal">
      <p class="eyebrow">Para compradores</p>
      <h2 class="section-title mt-5">No busques más. Elige mejor.</h2>
      <p class="mt-6 max-w-xl text-lg leading-8 text-ink/60">Comprar un patrimonio exige más que encontrar una foto atractiva. Requiere contexto, números y una negociación bien conducida.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/propiedades/" class="btn-primary">Explorar propiedades</a>
        <a href={whatsappLink("Hola Lourdes, quiero definir mi perfil de compra y conocer opciones.")} target="_blank" rel="noopener" class="btn-ghost-dark">Definir mi búsqueda</a>
      </div>
    </div>

    <ol class="reveal overflow-hidden rounded-[2rem] border border-ink/10 bg-cream">
      {pasos.map(([numero, titulo, texto]) => (
        <li class="grid gap-4 border-b border-ink/10 p-7 last:border-b-0 sm:grid-cols-[4rem_1fr] md:p-9">
          <span class="font-display text-sm font-semibold tracking-[0.18em] text-gold-dark">{numero}</span>
          <div>
            <h3 class="text-xl font-semibold">{titulo}</h3>
            <p class="mt-2 text-sm leading-7 text-ink/58">{texto}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
