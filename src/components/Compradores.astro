---
import { whatsappLink } from "../data/site";

const pasos = [
  "Definimos qué buscas y cuánto crédito te autorizan (INFONAVIT, FOVISSSTE o bancario).",
  "Te muestro solo propiedades que encajan con tu presupuesto y zona.",
  "Te acompaño en visitas, oferta, trámites y firma ante notario.",
];
---

<section id="compradores" class="bg-cream">
  <div class="section reveal grid items-center gap-10 md:grid-cols-2">
    <div>
      <p class="text-sm font-semibold uppercase tracking-widest text-gold-dark">Para compradores</p>
      <h2 class="mt-2 font-display text-3xl font-bold">¿Quieres comprar tu casa?</h2>
      <p class="mt-4 text-ink/70">
        Comprar tu primer patrimonio no tiene por qué ser complicado. Te guío paso a paso, incluso si no sabes por dónde empezar con el crédito.
      </p>
      <ol class="mt-6 space-y-4">
        {pasos.map((paso, i) => (
          <li class="flex gap-3">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gold font-semibold text-ink">{i + 1}</span>
            <span class="text-ink/80">{paso}</span>
          </li>
        ))}
      </ol>
      <a
        href={whatsappLink("Hola Lourdes, quiero comprar una propiedad. ¿Me ayudas?")}
        target="_blank"
        rel="noopener"
        class="mt-8 inline-block rounded-full bg-ink px-6 py-3 font-semibold text-white transition hover:bg-ink-soft"
      >
        Quiero comprar
      </a>
    </div>
    <div class="rounded-2xl border border-gold/30 bg-white p-8 shadow-sm">
      <h3 class="font-display text-xl font-semibold">Calcula tu compra</h3>
      <p class="mt-2 text-sm text-ink/70">
        ¿No sabes cuánto crédito te alcanza? Te ayudo a estimarlo sin costo y sin compromiso.
      </p>
      <a
        href={whatsappLink("Hola Lourdes, quiero saber cuánto crédito me autorizan.")}
        target="_blank"
        rel="noopener"
        class="mt-6 inline-block rounded-full border border-ink px-6 py-3 text-sm font-semibold transition hover:bg-ink hover:text-white"
      >
        Estimar mi crédito
      </a>
    </div>
  </div>
</section>
