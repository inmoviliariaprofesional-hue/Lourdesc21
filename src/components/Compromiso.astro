---
import { whatsappLink } from "../data/site";

const compromisos = [
  { numero: "01", titulo: "Difusión profesional", texto: "Publicidad estratégica y presentación del inmueble a mi cargo." },
  { numero: "02", titulo: "Gestión integral", texto: "Coordinación, documentación y seguimiento de principio a fin." },
  { numero: "03", titulo: "Prospectos calificados", texto: "Menos curiosos; más conversaciones con intención real." },
  { numero: "04", titulo: "Negociación experta", texto: "Cada decisión respaldada por mercado, datos y estrategia." },
];
---

<section id="compromiso" class="relative overflow-hidden bg-ivory">
  <div class="section">
    <div class="reveal grid items-end gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="eyebrow">Una promesa diferente</p>
        <h2 class="section-title mt-5 max-w-xl">Mi trabajo empieza antes que tu inversión.</h2>
      </div>
      <div class="max-w-2xl lg:justify-self-end">
        <p class="text-xl leading-relaxed text-ink/70 md:text-2xl">
          No recibo honorarios hasta que la operación se cierra. La difusión, la gestión y la estrategia corren por mi cuenta.
        </p>
        <p class="mt-4 text-sm text-ink/48">Aplica en operaciones de compra, venta y renta conforme al servicio contratado.</p>
      </div>
    </div>

    <div class="reveal mt-14 grid overflow-hidden rounded-[2rem] border border-ink/10 bg-white md:grid-cols-2 xl:grid-cols-4">
      {compromisos.map((item) => (
        <article class="group border-b border-ink/10 p-7 last:border-b-0 md:border-r md:[&:nth-child(2)]:border-r-0 xl:border-b-0 xl:[&:nth-child(2)]:border-r xl:last:border-r-0">
          <span class="font-display text-xs font-semibold tracking-[0.18em] text-gold-dark">{item.numero}</span>
          <h3 class="mt-8 text-xl font-semibold">{item.titulo}</h3>
          <p class="mt-3 text-sm leading-6 text-ink/58">{item.texto}</p>
          <div class="mt-7 h-px w-10 bg-gold transition-all duration-300 group-hover:w-full"></div>
        </article>
      ))}
    </div>

    <div class="reveal mt-10 flex flex-col items-start justify-between gap-5 rounded-[1.5rem] bg-ink px-7 py-7 text-white sm:flex-row sm:items-center lg:px-10">
      <div>
        <p class="font-display text-xl font-semibold text-gold-light">Tu tranquilidad es la prioridad.</p>
        <p class="mt-1 text-sm text-white/55">Conoce el proceso antes de tomar una decisión.</p>
      </div>
      <a href={whatsappLink("Hola Lourdes, quiero conocer cómo funciona tu servicio y los honorarios al cierre.")} target="_blank" rel="noopener" class="btn-primary shrink-0">
        Conocer el proceso
      </a>
    </div>
  </div>
</section>
