---
import { whatsappLink } from "../data/site";

const puntos = [
  { icono: "📣", texto: "Publicidad a mi cargo" },
  { icono: "💼", texto: "Gastos profesionales a mi cargo" },
  { icono: "📋", texto: "Gestión y trámites a mi cargo" },
  { icono: "📈", texto: "Estrategia a mi cargo" },
  { icono: "🤝", texto: "Tu tranquilidad es mi prioridad" },
];
---

<section id="compromiso" class="bg-ink text-white">
  <div class="section reveal">
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-block rounded-full border border-gold/60 px-4 py-1 text-xs font-semibold uppercase tracking-widest text-gold">
        Mi compromiso es contigo
      </span>
      <h2 class="mt-5 font-display text-3xl font-bold leading-tight md:text-4xl">
        No recibo comisión ni pago
        <span class="text-gold">hasta que se cierre la operación</span>
      </h2>
      <p class="mt-4 text-white/80">
        Todos los gastos corren por mi cuenta — ya sea <strong>venta</strong>, <strong>renta</strong> o <strong>compra</strong>. Tú solo te ocupas de decidir; del resto me encargo yo.
      </p>
    </div>

    <ul class="mx-auto mt-12 grid max-w-4xl gap-5 sm:grid-cols-2 lg:grid-cols-5">
      {puntos.map((p) => (
        <li class="flex flex-col items-center rounded-xl border border-white/10 bg-white/[0.03] px-4 py-6 text-center">
          <span class="text-3xl">{p.icono}</span>
          <span class="mt-3 text-sm font-medium text-white/85">{p.texto}</span>
        </li>
      ))}
    </ul>

    <div class="mt-12 text-center">
      <p class="font-display text-xl font-semibold text-gold">Éxito garantizado, pago garantizado.</p>
      <p class="mt-1 text-white/70">Mi única prioridad eres tú.</p>
      <a
        href={whatsappLink("Hola Lourdes, me interesa tu esquema: quiero saber más sobre tu compromiso sin costo hasta cerrar.")}
        target="_blank"
        rel="noopener"
        class="mt-6 inline-block rounded-full bg-gold px-6 py-3 font-semibold text-ink transition hover:bg-gold-dark"
      >
        Quiero trabajar con Lourdes
      </a>
    </div>
  </div>
</section>
