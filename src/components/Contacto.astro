---
import { site, whatsappLink } from "../data/site";
const redes = [
  ["Instagram", site.redes.instagram],
  ["Facebook", site.redes.facebook],
  ["TikTok", site.redes.tiktok],
];
---

<section id="contacto" class="bg-ivory">
  <div class="section">
    <div class="reveal overflow-hidden rounded-[2.2rem] bg-ink text-white">
      <div class="grid lg:grid-cols-[1.12fr_0.88fr]">
        <div class="relative p-7 sm:p-10 lg:p-14">
          <div class="premium-grid absolute inset-0 opacity-45"></div>
          <div class="relative">
            <p class="eyebrow !text-gold">Tu siguiente paso</p>
            <h2 class="section-title mt-5 max-w-2xl">Hablemos de lo que quieres lograr.</h2>
            <p class="mt-6 max-w-xl text-base leading-7 text-white/58">Una conversación de 15 minutos puede darte claridad sobre tu compra, venta, renta o inversión.</p>
            <a href={whatsappLink("Hola Lourdes, quiero agendar una conversación de 15 minutos.")} target="_blank" rel="noopener" class="btn-primary mt-9">Agendar conversación</a>
          </div>
        </div>

        <div class="border-t border-white/10 bg-white/[0.035] p-7 sm:p-10 lg:border-l lg:border-t-0 lg:p-12">
          <p class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-gold">Contacto directo</p>
          <dl class="mt-7 space-y-6 text-sm">
            <div>
              <dt class="text-white/38">WhatsApp</dt>
              <dd class="mt-1"><a href={whatsappLink()} target="_blank" rel="noopener" class="font-semibold text-white hover:text-gold-light">{site.telefonos[0]}</a></dd>
            </div>
            <div>
              <dt class="text-white/38">Correo</dt>
              <dd class="mt-1 break-all"><a href={`mailto:${site.emailOficial}`} class="font-semibold text-white hover:text-gold-light">{site.emailOficial}</a></dd>
            </div>
            <div>
              <dt class="text-white/38">Oficina</dt>
              <dd class="mt-1 leading-6 text-white/75">{site.direccionOficina}</dd>
            </div>
            <div>
              <dt class="text-white/38">Cobertura</dt>
              <dd class="mt-1 text-white/75">{site.cobertura}</dd>
            </div>
          </dl>
          <div class="mt-8 flex flex-wrap gap-4 border-t border-white/10 pt-6">
            {redes.map(([nombre, href]) => (
              <a href={href} target="_blank" rel="noopener" class="text-xs font-semibold text-white/55 transition hover:text-gold-light">{nombre} ↗</a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
