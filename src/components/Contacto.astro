---
import { site, whatsappLink } from "../data/site";
---

<section id="contacto" class="bg-cream">
  <div class="section">
    <div class="reveal grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="font-display text-3xl font-bold">Hablemos</h2>
        <p class="mt-3 text-ink/70">
          Estoy para ayudarte. Escríbeme por el medio que prefieras y te respondo lo antes posible.
        </p>

        <ul class="mt-8 space-y-4 text-sm">
          <li class="flex items-center gap-3">
            <span class="text-xl">💬</span>
            <a href={whatsappLink()} target="_blank" rel="noopener" class="font-semibold hover:text-gold-dark">
              WhatsApp: {site.telefonos[0]}
            </a>
          </li>
          {site.telefonos.map((tel) => (
            <li class="flex items-center gap-3">
              <span class="text-xl">📞</span>
              <a href={`tel:+52${tel.replace(/\s/g, "")}`} class="hover:text-gold-dark">{tel}</a>
            </li>
          ))}
          <li class="flex items-center gap-3">
            <span class="text-xl">✉️</span>
            <a href={`mailto:${site.emailOficial}`} class="hover:text-gold-dark">{site.emailOficial}</a>
          </li>
          <li class="flex items-center gap-3">
            <span class="text-xl">📍</span>
            <span>{site.zonas.join(" · ")} — {site.ciudad}</span>
          </li>
        </ul>

        <div class="mt-8 flex gap-4">
          <a href={site.redes.instagram} target="_blank" rel="noopener" class="rounded-full border border-ink px-4 py-2 text-sm font-semibold transition hover:bg-ink hover:text-white">Instagram</a>
          <a href={site.redes.facebook} target="_blank" rel="noopener" class="rounded-full border border-ink px-4 py-2 text-sm font-semibold transition hover:bg-ink hover:text-white">Facebook</a>
          <a href={site.redes.tiktok} target="_blank" rel="noopener" class="rounded-full border border-ink px-4 py-2 text-sm font-semibold transition hover:bg-ink hover:text-white">TikTok</a>
        </div>
      </div>

      <div class="flex items-center justify-center rounded-2xl border border-gold/30 bg-white p-8 text-center">
        <div>
          <p class="font-display text-xl font-semibold">¿List@ para dar el paso?</p>
          <p class="mt-2 text-sm text-ink/70">Agenda una llamada de 15 minutos sin compromiso.</p>
          <a
            href={whatsappLink("Hola Lourdes, quiero agendar una llamada de 15 minutos.")}
            target="_blank"
            rel="noopener"
            class="mt-6 inline-block rounded-full bg-gold px-6 py-3 font-semibold text-ink transition hover:bg-gold-dark"
          >
            Agendar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
